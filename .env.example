# Copy to .env (same directory as docker-compose.yml) and fill in before deploying.

# Required in production — any long random string.
JWT_SECRET=change-me-in-production

# Set to "false" to disable new account sign-up (existing logins still work).
# Default "true" — turn this off once you've created the account(s) you need,
# to make this self-hosted instance invite-only.
ALLOW_SIGNUP=true

# Port the app is exposed on (http://localhost:HTTP_PORT). Not used by Dokploy,
# which assigns its own domain/port per service.
HTTP_PORT=8080

# Optional S3 (or S3-compatible) storage backend. Leave blank to use local disk only.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
# "local" (default) or "s3" — where NEW uploads are stored. S3 "link from bucket"
# browsing works whenever the AWS_* vars above are set, regardless of this value.
STORAGE_DRIVER=local

# Optional SMB/network share ("link existing content" only, nothing is ever
# uploaded to it). Leave blank to disable.
SMB_HOST=
SMB_SHARE=
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=WORKGROUP
SMB_PORT=445
# Max size (MB) of server/smb-cache/, the local cache of files played from the
# SMB share (see README). Least-recently-played files are evicted once this
# cap is exceeded. Default 10240 (10 GB) — raise this if the server and your
# NAS are on the same local network (fast, free re-downloads); keep it low if
# SMB traffic has to cross the internet to reach the share.
SMB_CACHE_MAX_MB=10240
# Folder (within the share) that "Sync SMB folder" and scheduled sync scan
# recursively for audio files to auto-link. Blank (default) = whole share.
SMB_SYNC_PATH=
# Minutes between automatic background syncs, for every existing account.
# 0/unset (default) = scheduled sync disabled; use the manual "Sync SMB
# folder" button in the library instead.
SMB_SYNC_INTERVAL_MINUTES=0
